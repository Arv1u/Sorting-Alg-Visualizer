<Window xmlns="https://github.com/avaloniaui"
        xmlns:avalonia="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:local="using:Sorting_Alg_Visualizer"
        xmlns:VM="using:Sorting_Alg_Visualizer.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Sorting_Alg_Visualizer.MainWindow"
        x:DataType="VM:MainWindowViewModel"
        Title="Sorting-Alg-Visualizer"
        >
    <Grid ColumnDefinitions="15*, 85*"
          RowDefinitions="15*, 85*">
        <StackPanel Grid.RowSpan="2"
                    Background="Blue">
            
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    Background="Green">
            <Button Content="Start" Margin="5" Command="{Binding StartCommand}"/>
            <Button Content="Pause" Command="{Binding PauseCommand}" Margin="5"/>
            <Button Content="Reset" Command="{Binding ResetCommand}" Margin="5"/>
        </StackPanel>
        <lvc:CartesianChart Grid.Row="1"
                            Grid.Column="1"
                                 LegendPosition="Right"
                                 Margin="10"
                            DataContext="{Binding ChartVM}"
                                    AutoUpdateEnabled="True"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                              x:Name="BarChart" >
            <lvc:CartesianChart.Series>
                <lvc:SeriesCollection>
                    <lvc:XamlColumnSeries
                        Values="{Binding Values.Elements, UpdateSourceTrigger=PropertyChanged}"
                        IsVisibleAtLegend="False"
                        PointMeasuredCommand="{Binding PointMeasuredCommand}"
                        />          
                </lvc:SeriesCollection>
            </lvc:CartesianChart.Series>
        </lvc:CartesianChart>
                                     
        </Grid>
</Window>