<Window xmlns="https://github.com/avaloniaui"
        xmlns:avalonia="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:local="using:Sorting_Alg_Visualizer"
        xmlns:VM="using:Sorting_Alg_Visualizer.ViewModels"
        xmlns:conv="Sorting_Alg_Visualizer.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Sorting_Alg_Visualizer.MainWindow"
        x:DataType="VM:MainWindowViewModel"
        Title="Sorting-Alg-Visualizer"
        >
    <Grid ColumnDefinitions="15*, 85*"
          RowDefinitions="15*, 85*">
        <StackPanel Grid.RowSpan="2"
                    Background="Blue">
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    >
            <Button Content="Start" Margin="5" Command="{Binding StartCommand}"/>
            <Button Content="Pause" Command="{Binding PauseCommand}" Margin="5"/>
            <Button Content="Reset" Command="{Binding ResetCommand}" Margin="5"/>
            <StackPanel VerticalAlignment="Center" Margin="10 10 10 10">
            <StackPanel Orientation="Horizontal">
            <TextBlock Text="Steps Per Second:"></TextBlock>   
            <TextBlock Text="{Binding StepsPerSecond}"
                       VerticalAlignment="Center"
                       Margin="5 0 0 0"
                       MinWidth="100"
                       />
            </StackPanel>
            <Slider Minimum="1" 
                    Maximum="1000" 
                    Value="{Binding StepsPerSecond}" 
                    MinWidth="300"
                    VerticalAlignment="Center">
            </Slider> 
            </StackPanel>
            <NumericUpDown Minimum="1" 
                           Maximum="1000"
                           Margin="20"
                           Value="{Binding SortLength, 
                           Mode=TwoWay}" 
                           FormatString="0"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           VerticalAlignment="Center"
                           MinWidth="150"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Algorithms}"
                 SelectedItem="{Binding SelectedAlgorithm, Mode=TwoWay}"
                 SelectionMode="AlwaysSelected"
                 IsEnabled="{Binding !IsRunning}"
                 Grid.RowSpan="2">
           <ListBox.Styles>
               <Style Selector="ListBoxItem">
                   <Setter  Property="Margin" Value="8"></Setter>
                   <Setter  Property="BorderBrush" Value="black"></Setter>
                   <Setter  Property="BorderThickness" Value="2"></Setter>
                   <Setter Property="CornerRadius" Value="11"></Setter>
               </Style>

           </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                    <StackPanel >
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                  
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <lvc:CartesianChart Grid.Row="1"
                            Grid.Column="1"
                            Margin="10"
                            DataContext="{Binding ChartVM}"
                            AutoUpdateEnabled="True"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            x:Name="BarChart"
                            AnimationsSpeed="0">
            <lvc:CartesianChart.Series>
                <lvc:SeriesCollection>
                    <lvc:XamlColumnSeries
                        Values="{Binding Values.Elements, Mode=TwoWay}"
                        IsVisibleAtLegend="False"
                        PointMeasuredCommand="{Binding PointMeasuredCommand}"
                        />          
                </lvc:SeriesCollection>
            </lvc:CartesianChart.Series>
        </lvc:CartesianChart>
        </Grid>
</Window>